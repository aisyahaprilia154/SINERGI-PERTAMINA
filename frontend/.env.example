# Proxy same-origin bawaan. Ganti URL ini hanya jika organisasi memakai tile server sendiri.
VITE_SINERGI_VECTOR_TILES_URL=/api/basemap/openfreemap/planet

# Citra satelit bawaan: Esri World Imagery. Isi URL dan atribusi jika memakai penyedia lain.
# Peta vektor tetap dipakai untuk label jalan di atas citra.
VITE_SINERGI_BASEMAP_TILES=
VITE_SINERGI_BASEMAP_ATTRIBUTION=
# Last real raster tile level; map zoom itself remains available above this.
VITE_SINERGI_BASEMAP_MAX_ZOOM=18
