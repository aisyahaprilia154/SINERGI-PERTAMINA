# Proxy same-origin bawaan. Ganti URL ini hanya jika organisasi memakai tile server sendiri.
VITE_SINERGI_VECTOR_TILES_URL=/api/basemap/openfreemap/planet

# Endpoint same-origin bawaan runner lokal. Backend meneruskan permintaan ke
# SINERGI_IMAGERY_TILE_TEMPLATE agar URL provider tidak diekspos ke browser.
VITE_SINERGI_BASEMAP_TILES=/api/basemap/imagery/tiles/{z}/{x}/{y}.jpg
VITE_SINERGI_BASEMAP_MAX_ZOOM=18
VITE_SINERGI_BASEMAP_ATTRIBUTION=Sources: Esri, Maxar, Earthstar Geographics, and the GIS User Community
