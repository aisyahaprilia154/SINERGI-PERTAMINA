# Primary: neutral-light CARTO Positron. Token optional dan tidak disimpan di source.
VITE_MAP_PRIMARY_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_PRIMARY_ATTRIBUTION=&copy; OpenStreetMap contributors, &copy; CARTO
VITE_MAP_PRIMARY_SUBDOMAINS=abcd
VITE_MAP_PRIMARY_TOKEN=
VITE_MAP_PRIMARY_MAX_NATIVE_ZOOM=20

# Fallback 1: CARTO Voyager.
VITE_MAP_FALLBACK_1_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_MAP_FALLBACK_1_ATTRIBUTION=&copy; OpenStreetMap contributors, &copy; CARTO
VITE_MAP_FALLBACK_1_SUBDOMAINS=abcd
VITE_MAP_FALLBACK_1_TOKEN=
VITE_MAP_FALLBACK_1_MAX_NATIVE_ZOOM=20

# Fallback 2: OpenStreetMap Standard. Gunakan "none" untuk menonaktifkan satu slot.
VITE_MAP_FALLBACK_2_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri ...
# VITE_MAP_SATELLITE_TOKEN=
VITE_MAP_FALLBACK_2_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_FALLBACK_2_SUBDOMAINS=
VITE_MAP_FALLBACK_2_TOKEN=
VITE_MAP_FALLBACK_2_MAX_NATIVE_ZOOM=19

# Waktu tunggu per provider sebelum berpindah ke fallback berikutnya.
VITE_MAP_BASEMAP_TIMEOUT_MS=8000

VITE_MAP_MIN_ZOOM=10
VITE_MAP_MAX_ZOOM=22
VITE_MAP_MAX_NATIVE_ZOOM=19
VITE_MAP_FIT_MAX_ZOOM=19

# Tier detail dihitung relatif terhadap fit zoom data Pengapon.
VITE_MAP_LOW_ZOOM_OFFSET=0
VITE_MAP_HIGH_ZOOM_OFFSET=3

# Override absolut opsional. Biarkan kosong agar mengikuti fit zoom Pengapon.
VITE_MAP_LOW_ZOOM_MAX=
VITE_MAP_HIGH_ZOOM_MIN=
