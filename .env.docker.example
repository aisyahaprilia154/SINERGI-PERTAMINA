# Copy this file to .env.docker for a local deployment and replace secrets.
POSTGRES_DB=sinergi
POSTGRES_USER=sinergi
POSTGRES_PASSWORD=change-me-before-sharing
SINERGI_HTTP_PORT=5173
# 127.0.0.1 untuk lokal; 0.0.0.0 untuk berbagi web dari satu server di LAN.
SINERGI_HTTP_BIND_ADDRESS=127.0.0.1
SINERGI_API_PORT=5000
VITE_SINERGI_VECTOR_TILES_URL=/api/basemap/openfreemap/planet
# Opsional: kosongkan untuk memakai Esri World Imagery bawaan.
VITE_SINERGI_BASEMAP_TILES=
VITE_SINERGI_BASEMAP_ATTRIBUTION=
