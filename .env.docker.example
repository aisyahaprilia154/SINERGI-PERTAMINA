# Copy this file to .env.docker for a local deployment and replace secrets.
POSTGRES_DB=sinergi
POSTGRES_USER=sinergi
POSTGRES_PASSWORD=change-me-before-sharing
SINERGI_AUTH_TOKENS={"local-admin":{"id":"local-admin","role":"Administrator","name":"Local Administrator"}}
# Backend import scope. Replace/add branch mappings for the deployment.
SINERGI_BRANCH_IDS=semarang
SINERGI_BRANCH_DATASETS={"semarang":"dataset-semarang"}
SINERGI_HTTP_PORT=5173
SINERGI_API_PORT=5000
VITE_SINERGI_VECTOR_TILES_URL=/api/basemap/openfreemap/planet
