# Copy to .env.production (ignored by Git). Generate independent random hex secrets.
POSTGRES_DB=sinergi
POSTGRES_USER=sinergi_owner
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX
SINERGI_RUNTIME_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_RANDOM_HEX
SINERGI_TLS_DIR=REPLACE_WITH_ABSOLUTE_CERTIFICATE_DIRECTORY
SINERGI_HTTP_BIND_ADDRESS=127.0.0.1
SINERGI_HTTP_PORT=80
SINERGI_HTTPS_PORT=443
SINERGI_PROXY_SUBNET=172.30.221.0/24
SINERGI_BACKEND_IMAGE=sinergi-backend:local
SINERGI_FRONTEND_IMAGE=sinergi-frontend:local
